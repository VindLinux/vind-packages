src="linux-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://cdn.kernel.org/pub/linux/kernel/v${PKG_VERSION%%.*}.x/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make INSTALL_HDR_PATH="$DESTDIR$PREFIX" headers_install
}
