src="readline-8.3"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o readline-8.3.tar.gz https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz
    tar -xf readline-8.3.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --with-curses
    make SHLIB_LIBS="-lncursesw" $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
