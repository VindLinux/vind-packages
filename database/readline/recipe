src="readline-8.3"
patch_url="https://ftp.gnu.org/gnu/readline/readline-8.3-patches"

pkg_download()
{
    fetch_source readline-8.3.tar.gz || exit 1
    tar -xf readline-8.3.tar.gz

    n=1
    while [ "$n" -le 30 ]; do
        id=$(printf '%03d' "$n")
        [ -f "readline83-$id" ] || \
            curl -fL -o "readline83-$id" "$patch_url/readline83-$id" 2>/dev/null || {
                rm -f "readline83-$id"
                break
            }
        n=$((n + 1))
    done

    [ -f readline83-002 ] || { echo "readline83-002 patch failed to download" >&2; exit 1; }
}

pkg_build()
{
    cd "$src" || exit 1

    for p in ../readline83-*; do
        [ -f "$p" ] || continue
        patch -p0 -N < "$p" || exit 1
    done

    ./configure --prefix="$PREFIX" --disable-static --with-curses
    make SHLIB_LIBS="-lncursesw" $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
