src="readline-8.2"

pkg_download()
{
    fetch_source readline-8.2.tar.gz || exit 1
    tar -xf readline-8.2.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --with-curses
    make SHLIB_LIBS="-lncursesw" $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
