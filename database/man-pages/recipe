src="man-pages-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1

    find "$src/share/mk/install" -type f -name '*.mk' \
        -exec sed -i 's/ -T / /g; s/ -fsT / -fs /g' {} + || exit 1
}

pkg_install()
{
    make -R -C "$src" DESTDIR="$DESTDIR$PREFIX" install
}
