src="man-pages-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://www.kernel.org/pub/linux/docs/man-pages/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_install()
{
    make -C "$src" DESTDIR="$DESTDIR$PREFIX" install
}
