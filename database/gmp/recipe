src="gmp-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://ftp.gnu.org/gnu/gmp/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix="$PREFIX" --enable-cxx || exit 1
    CFLAGS="$CFLAGS -std=gnu17" make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
