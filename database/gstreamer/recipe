src="gstreamer-$PKG_VERSION"
tarball="gstreamer-$PKG_VERSION.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir=lib --buildtype=release \
           --wrap-mode=nodownload \
           -Dintrospection=disabled -Dtests=disabled -Dexamples=disabled \
           -Dbenchmarks=disabled -Ddoc=disabled -Dtools=enabled \
           -Dptp-helper=disabled -Dlibdw=disabled \
           -Dbash-completion=enabled

    if attr_on libunwind; then
        set -- "$@" -Dlibunwind=enabled
    else
        set -- "$@" -Dlibunwind=disabled
    fi

    if attr_on nls; then
        set -- "$@" -Dnls=enabled
    else
        set -- "$@" -Dnls=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
