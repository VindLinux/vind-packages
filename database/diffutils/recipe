src="diffutils-$PKG_VERSION"

pkg_download()
{
    fetch_source "diffutils-$PKG_VERSION.tar.xz" || exit 1
    tar -xf "diffutils-$PKG_VERSION.tar.xz"
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
