src="libXext-1.3.7"

pkg_download()
{
    fetch_source libXext-1.3.7.tar.xz || exit 1
    tar -xf libXext-1.3.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXext-1.3.7"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
