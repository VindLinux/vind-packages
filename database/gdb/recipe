src="gdb-${PKG_VERSION}"
tarball="gdb-${PKG_VERSION}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --disable-werror --with-system-zlib --with-system-readline --with-expat --without-lzma --without-guile --without-babeltrace --without-debuginfod

    if attr_on python; then
        set -- "$@" --with-python=python3
    else
        set -- "$@" --without-python
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make -C gdb DESTDIR="$DESTDIR" install
}
