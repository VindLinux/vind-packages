src="libFS-1.0.10"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libFS-1.0.10.tar.xz https://www.x.org/pub/individual/lib/libFS-1.0.10.tar.xz
    tar -xf libFS-1.0.10.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libFS-1.0.10"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
