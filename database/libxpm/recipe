src="libXpm-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://www.x.org/pub/individual/lib/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/$src"

    if attr_on zfile; then
        set -- "$@" --enable-open-zfile
    else
        set -- "$@" --disable-open-zfile
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
