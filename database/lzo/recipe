src="lzo-${PKG_VERSION}"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX"

    if attr_on shared; then
        set -- "$@" --enable-shared
    fi

    if ! attr_on static; then
        set -- "$@" --disable-static
    fi

    if ! attr_on asm; then
        set -- "$@" --disable-asm
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
