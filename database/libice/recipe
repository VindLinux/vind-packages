src="libICE-1.1.2"

pkg_download()
{
    fetch_source libICE-1.1.2.tar.xz || exit 1
    tar -xf libICE-1.1.2.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libICE-1.1.2"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
