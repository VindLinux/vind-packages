src="tiff-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://download.osgeo.org/libtiff/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    ./configure --prefix="$PREFIX" \
                --disable-libdeflate --disable-jbig --disable-lerc \
                --disable-webp --disable-opengl --without-x \
                --disable-docs --disable-sphinx --disable-tests \
                --disable-contrib || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
