src="libXdmcp-1.1.5"

pkg_download()
{
    fetch_source libXdmcp-1.1.5.tar.xz || exit 1
    tar -xf libXdmcp-1.1.5.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="\${datadir}/doc/libXdmcp-1.1.5"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
