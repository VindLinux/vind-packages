src="libjpeg-turbo-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    cmake -G Ninja -S . -B build \
        -D CMAKE_INSTALL_PREFIX="$PREFIX" \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_SKIP_INSTALL_RPATH=ON \
        -D CMAKE_BUILD_TYPE=Release \
        -D ENABLE_SHARED=ON \
        -D ENABLE_STATIC=ON \
        -D WITH_SIMD=ON \
        -D REQUIRE_SIMD=ON \
        -D WITH_TURBOJPEG=ON \
        -D WITH_TOOLS=ON \
        -D WITH_TESTS=OFF \
        -D WITH_SYSTEM_ZLIB=ON \
        -W no-dev || exit 1

    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install || exit 1
}
