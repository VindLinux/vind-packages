src="tzdata-2025b"

pkg_download()
{
    fetch_source tzdata2025b.tar.gz || exit 1
    curl -fL --retry 3 --retry-delay 2 -o tzcode2025b.tar.gz https://data.iana.org/time-zones/releases/tzcode2025b.tar.gz || exit 1
    mkdir -p tzdata-2025b
    tar -xf tzcode2025b.tar.gz -C tzdata-2025b
    tar -xf tzdata2025b.tar.gz -C tzdata-2025b
}

pkg_build()
{
    cd "$src" || exit 1
    make zic
    mkdir -p zoneinfo
    ./zic -d zoneinfo -L /dev/null africa antarctica asia australasia europe northamerica southamerica etcetera backward
}

pkg_install()
{
    install -d "$DESTDIR$PREFIX/share/zoneinfo"
    cp -r "$src/zoneinfo/." "$DESTDIR$PREFIX/share/zoneinfo/"
}
