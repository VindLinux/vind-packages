src="tcl${PKG_VERSION}"
tarball="$src-src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src/unix" || exit 1

    set -- --prefix="$PREFIX"

    if ! attr_on shared; then
        set -- "$@" --disable-shared
    fi

    if ! attr_on threads; then
        set -- "$@" --disable-threads
    fi

    if ! attr_on zipfs; then
        set -- "$@" --disable-zipfs
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src/unix" || exit 1
    make DESTDIR="$DESTDIR" install
}
