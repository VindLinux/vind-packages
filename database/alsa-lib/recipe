src="alsa-lib-${PKG_VERSION}"
tarball="${src}.tar.bz2"

pkg_download()
{
    fetch_source "$tarball" || exit 1

    bzip2 -t "$tarball" || { rm -f "$tarball"; exit 1; }
    bzip2 -dc "$tarball" | tar -xf - || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    sed -i '1i #include <unistd.h>\n#include <sys/syscall.h>\n#ifndef SYS_close_range\n#define SYS_close_range 436\n#endif\nstatic inline int close_range(unsigned int a, unsigned int b, int f) { return syscall(SYS_close_range, a, b, f); }' src/ucm/ucm_exec.c
    export CFLAGS="${CFLAGS} -D_GNU_SOURCE"

    set -- --prefix="$PREFIX" --disable-maintainer-mode

    if ! attr_on python; then
        set -- "$@" --disable-python
    fi

    if attr_on mixermodules; then
        set -- "$@" --enable-mixer-modules
    fi

    if attr_on mixerpymods; then
        set -- "$@" --enable-mixer-pymods
    fi

    if ! attr_on topology; then
        set -- "$@" --disable-topology
    fi

    if attr_on debug; then
        set -- "$@" --enable-debug
    fi

    if attr_on static; then
        set -- "$@" --enable-static
    fi

    if attr_on symbolic; then
        set -- "$@" --enable-symbolic-functions
    fi

    if attr_on lockless; then
        set -- "$@" --enable-lockless-dmix
    fi

    ./configure "$@" || exit 1
    [ -e src/conf/smixer.conf ] || : > src/conf/smixer.conf
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
