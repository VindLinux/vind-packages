src="libXau-1.0.12"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libXau-1.0.12.tar.xz https://www.x.org/pub/individual/lib/libXau-1.0.12.tar.xz
    tar -xf libXau-1.0.12.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
