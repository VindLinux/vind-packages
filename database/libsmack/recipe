src="smack-4a102c7584b39ce693995ffb65e0918a9df98dd8"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    autoreconf -fi || exit 1

    ./configure --prefix="$PREFIX" --with-systemdsystemunitdir=no || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
