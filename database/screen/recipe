src="screen-5.0.2"

pkg_download()
{
    fetch_source screen-5.0.2.tar.gz || exit 1
    tar -xf screen-5.0.2.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --with-pty-mode=0620 --with-pty-group=5 --with-sys-screenrc=/etc/screenrc
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
    install -m 644 etc/etcscreenrc "$DESTDIR/etc/screenrc"
}
