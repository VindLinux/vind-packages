src="seatd-0.9.3"

pkg_download()
{
    fetch_source seatd-0.9.3.tar.gz || exit 1
    tar -xf seatd-0.9.3.tar.gz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Dlibseat-seatd=enabled -Dlibseat-logind=disabled -Dlibseat-builtin=enabled -Dserver=enabled -Dexamples=disabled -Dman-pages=disabled -Dwerror=false || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
