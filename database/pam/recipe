src="Linux-PAM-1.7.2"

pkg_download()
{
    fetch_source Linux-PAM-1.7.2.tar.xz || exit 1
    tar -xf Linux-PAM-1.7.2.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    meson setup build --prefix="$PREFIX" --libdir="$PREFIX/lib" --buildtype=release -Ddocs=disabled -Daudit=disabled -Dselinux=disabled -Dlogind=disabled -Delogind=disabled -Dopenssl=disabled -Dnis=disabled -Dpam_lastlog=disabled
    ninja -C build
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build --no-rebuild
}
