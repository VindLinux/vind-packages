src="lcms2-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/mm2/Little-CMS/releases/download/lcms$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --disable-static

    if attr_on fastfloat; then
        set -- "$@" --with-fastfloat
    fi

    if attr_on threaded; then
        set -- "$@" --with-threaded
    fi

    if ! attr_on zlib; then
        set -- "$@" --without-zlib
    fi

    if ! attr_on jpeg; then
        set -- "$@" --without-jpeg
    fi

    if ! attr_on tiff; then
        set -- "$@" --without-tiff
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    make -C "$src" DESTDIR="$DESTDIR" install
}
