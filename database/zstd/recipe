src="zstd-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/facebook/zstd/releases/download/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    make -C "$src" $MAKEOPTS
}

pkg_install()
{
    make -C "$src" DESTDIR="$DESTDIR" PREFIX="$PREFIX" install
}
