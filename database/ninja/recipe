src="ninja-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/ninja-build/ninja/archive/refs/tags/v$PKG_VERSION.tar.gz" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    CXX="$CXX" CXXFLAGS="$CXXFLAGS -stdlib=libc++" LDFLAGS="$LDFLAGS -stdlib=libc++" python3 configure.py --bootstrap
}

pkg_install()
{
    install -Dm755 "$src/ninja" "$DESTDIR$PREFIX/bin/ninja"
}
