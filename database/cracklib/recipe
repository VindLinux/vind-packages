src="cracklib-${PKG_VERSION}"
tarball="cracklib-${PKG_VERSION}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --without-python || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
    mkdir -p "$DESTDIR$PREFIX/share/cracklib" || exit 1
    util/cracklib-format dicts/cracklib-small | util/cracklib-packer "$DESTDIR$PREFIX/share/cracklib/pw_dict"
}
