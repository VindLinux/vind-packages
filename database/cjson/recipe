src="cJSON-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/DaveGamble/cJSON/archive/refs/tags/v$PKG_VERSION.tar.gz" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    make PREFIX="$PREFIX" $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make PREFIX="$PREFIX" DESTDIR="$DESTDIR" install
}
