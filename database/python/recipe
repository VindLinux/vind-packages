src="Python-3.13.7"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o Python-3.13.7.tar.xz https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tar.xz
    tar -xf Python-3.13.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --with-openssl="$PREFIX" --enable-shared --with-system-expat --with-ensurepip=upgrade --without-static-libpython
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
