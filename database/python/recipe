src="Python-3.13.7"

pkg_download()
{
    fetch_source Python-3.13.7.tar.xz || exit 1
    tar -xf Python-3.13.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --with-openssl="$PREFIX" --enable-shared --with-system-expat --with-ensurepip=upgrade --without-static-libpython
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
