year="2026"
src="sqlite-autoconf-$(printf '%s' "$PKG_VERSION" | awk -F. '{printf "%d%02d%02d00", $1, $2, $3}')"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://sqlite.org/$year/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --enable-readline --disable-static

    if attr_on icu; then
        set -- "$@" --with-icu-config=auto
    fi

    CPPFLAGS="-DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_SECURE_DELETE" ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
