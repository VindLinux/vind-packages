src="ranger-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        https://ranger.fm/ranger-stable.tar.gz || exit 1
    mkdir -p "$src" || exit 1
    tar -xf "$tarball" --strip-components=1 -C "$src" || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    python3 setup.py install --root="$DESTDIR" --prefix="$PREFIX" --optimize=1
}
