src="musl-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://musl.libc.org/releases/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --syslibdir="$PREFIX/lib" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1

    mkdir -p "$DESTDIR$PREFIX/sbin" || exit 1
    printf '#!/bin/sh\nexit 0\n' > "$DESTDIR$PREFIX/sbin/ldconfig" || exit 1
    chmod 0755 "$DESTDIR$PREFIX/sbin/ldconfig"
}
