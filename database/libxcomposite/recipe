src="libXcomposite-0.4.7"

pkg_download()
{
    fetch_source libXcomposite-0.4.7.tar.xz || exit 1
    tar -xf libXcomposite-0.4.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXcomposite-0.4.7"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
