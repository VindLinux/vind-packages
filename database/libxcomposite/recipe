src="libXcomposite-0.4.7"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libXcomposite-0.4.7.tar.xz https://www.x.org/pub/individual/lib/libXcomposite-0.4.7.tar.xz
    tar -xf libXcomposite-0.4.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXcomposite-0.4.7"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
