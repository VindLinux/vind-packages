src="dbus-$PKG_VERSION"

pkg_download()
{
    fetch_source "dbus-$PKG_VERSION.tar.xz" || exit 1
    tar -xf "dbus-$PKG_VERSION.tar.xz"
}

pkg_build()
{
    cd "$src" || exit 1

    apparmor_flag="-Dapparmor=disabled"
    if attr_on apparmor; then
        apparmor_flag="-Dapparmor=enabled"
    fi

    meson setup --prefix="$PREFIX" --libdir="$PREFIX/lib" --sysconfdir=/etc --localstatedir=/var --buildtype=release --wrap-mode=nofallback -Dsystemd=disabled -Dselinux=disabled $apparmor_flag build
    ninja -C build
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
