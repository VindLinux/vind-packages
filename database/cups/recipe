src="cups-${PKG_VERSION}"
tarball="$src-source.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    sed -i \
        -e 's|^\([[:space:]]*data\.num_local[[:space:]]*= 0;.*\)$|#ifdef HAVE_DNSSD\n\1\n#endif|' \
        -e 's|^\([[:space:]]*data\.local_dests[[:space:]]*= NULL;.*\)$|#ifdef HAVE_DNSSD\n\1\n#endif|' \
        -e 's|^\([[:space:]]*data\.num_local = cupsCopyDest.*\)$|#ifdef HAVE_DNSSD\n\1\n#endif|' \
        -e 's|^\([[:space:]]*cupsFreeDests(data\.num_local, data\.local_dests);.*\)$|#ifdef HAVE_DNSSD\n\1\n#endif|' \
        cups/dest.c || exit 1

    set -- --prefix="$PREFIX" --with-rcdir=no

    if ! attr_on daemon; then
        set -- "$@" --with-components=libcups
    fi

    if attr_on gnutls; then
        set -- "$@" --with-tls=gnutls
    elif attr_on openssl; then
        set -- "$@" --with-tls=openssl
    else
        set -- "$@" --with-tls=no
    fi

    if attr_on avahi; then
        set -- "$@" --with-dnssd=avahi
    else
        set -- "$@" --with-dnssd=no
    fi

    if attr_on usb; then
        set -- "$@" --enable-libusb
    else
        set -- "$@" --disable-libusb
    fi

    if attr_on acl; then
        set -- "$@" --enable-acl
    else
        set -- "$@" --disable-acl
    fi

    if ! attr_on dbus; then
        set -- "$@" --disable-dbus
    fi

    if ! attr_on pam; then
        set -- "$@" --disable-pam
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make BUILDROOT="$DESTDIR" install
}
