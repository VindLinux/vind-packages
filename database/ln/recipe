src="coreutils-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" FORCE_UNSAFE_CONFIGURE=1 || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    mkdir -p "$DESTDIR$PREFIX/bin" || exit 1
    cp -v "$src/src/ln" "$DESTDIR$PREFIX/bin/ln"
}
