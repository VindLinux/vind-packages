src="xcb-util-wm-0.4.2"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o xcb-util-wm-0.4.2.tar.gz https://xcb.freedesktop.org/dist/xcb-util-wm-0.4.2.tar.gz
    tar -xf xcb-util-wm-0.4.2.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
