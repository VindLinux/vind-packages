src="xcb-util-wm-0.4.2"

pkg_download()
{
    fetch_source xcb-util-wm-0.4.2.tar.gz || exit 1
    tar -xf xcb-util-wm-0.4.2.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
