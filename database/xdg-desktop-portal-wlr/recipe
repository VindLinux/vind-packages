src="xdg-desktop-portal-wlr-${PKG_VERSION}"
tarball="xdg-desktop-portal-wlr-${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    meson setup build --prefix="$PREFIX" --buildtype=release -Dwerror=false -Dsd-bus-provider=basu -Dsystemd=disabled -Dman-pages=disabled || exit 1
    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
