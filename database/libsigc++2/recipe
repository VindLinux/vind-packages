src="libsigc++-$PKG_VERSION"
tarball="libsigc++-$PKG_VERSION.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    meson setup _build --prefix="$PREFIX" --libdir=lib --buildtype=release \
        --wrap-mode=nodownload \
        -Dmaintainer-mode=false -Dbuild-documentation=false \
        -Dvalidation=false -Dbuild-examples=false -Dbuild-tests=false \
        -Dbenchmark=false || exit 1

    ninja -C _build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C _build || exit 1
}
