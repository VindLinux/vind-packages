src="xcb-proto-1.17.0"

pkg_download()
{
    fetch_source xcb-proto-1.17.0.tar.xz || exit 1
    tar -xf xcb-proto-1.17.0.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    PYTHON=python3 ./configure $XORG_CONFIG
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
