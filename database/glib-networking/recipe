src="glib-networking-${PKG_VERSION}"
tarball="glib-networking-${PKG_VERSION}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --buildtype=release -Dtests=false

    if attr_on libproxy; then
        set -- "$@" -Dlibproxy=enabled
    else
        set -- "$@" -Dlibproxy=disabled -Denvironment_proxy=enabled
    fi

    if attr_on gnome; then
        set -- "$@" -Dgnome_proxy=enabled
    else
        set -- "$@" -Dgnome_proxy=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
