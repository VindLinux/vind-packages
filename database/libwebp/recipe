src="libwebp-$PKG_VERSION"
tarball="libwebp-$PKG_VERSION.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --disable-gl --disable-sdl --disable-gif

    if ! attr_on tiff; then
        set -- "$@" --disable-tiff
    fi

    CPPFLAGS="$CPPFLAGS -I$PREFIX/include" \
    LDFLAGS="$LDFLAGS -L$PREFIX/lib" \
    ./configure "$@" || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
