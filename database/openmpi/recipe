src="openmpi-${PKG_VERSION}"
tarball="openmpi-${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --with-hwloc=internal --with-libevent=internal --with-pmix=internal --with-prrte=internal --enable-mpi-fortran=no --disable-oshmem || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
