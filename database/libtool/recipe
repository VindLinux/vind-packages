src="libtool-2.5.4"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libtool-2.5.4.tar.xz https://ftp.gnu.org/gnu/libtool/libtool-2.5.4.tar.xz
    tar -xf libtool-2.5.4.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
