src="atkmm-${PKG_VERSION}"
tarball="${src}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    meson setup builddir --prefix="$PREFIX" --libdir=lib --buildtype=release || exit 1
    ninja -C builddir $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C builddir --no-rebuild
}
