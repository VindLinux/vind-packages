src="gettext-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://ftp.gnu.org/gnu/gettext/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" \
        --disable-static \
        --docdir="$PREFIX/share/doc/gettext-$PKG_VERSION"

    if ! attr_on curses; then
        set -- "$@" --disable-curses
    fi

    if ! attr_on emacs; then
        set -- "$@" --without-emacs
    fi

    if ! attr_on java; then
        set -- "$@" --disable-java
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
