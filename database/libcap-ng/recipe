src="stevegrubb-libcap-ng-c382c64"
tarball="libcap-ng_${PKG_VERSION}.orig.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./autogen.sh || exit 1
    ./configure --prefix="$PREFIX" --without-python || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
