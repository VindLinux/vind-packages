src="flac-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://downloads.xiph.org/releases/flac/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    ./configure --prefix="$PREFIX" --with-ogg="$PREFIX" \
                --disable-doxygen-docs --disable-examples \
                --disable-thorough-tests --disable-version-from-git \
                --disable-rpath || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
