src="eudev-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/eudev-project/eudev/releases/download/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" \
        --sysconfdir=/etc \
        --bindir="$PREFIX/sbin" \
        --enable-manpages \
        --disable-static

    if attr_on blkid; then
        set -- "$@" --enable-blkid
    else
        set -- "$@" --disable-blkid
    fi

    if attr_on rule_generator; then
        set -- "$@" --enable-rule-generator
    else
        set -- "$@" --disable-rule-generator
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    mkdir -p "$DESTDIR$PREFIX/lib/udev/rules.d" "$DESTDIR/etc/udev/rules.d" || exit 1
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
