src="kmod-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --libdir="$PREFIX/lib" --buildtype=release --wrap-mode=nodownload || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
