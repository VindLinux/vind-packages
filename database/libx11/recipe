src="libX11-1.8.13"

pkg_download()
{
    fetch_source libX11-1.8.13.tar.xz || exit 1
    tar -xf libX11-1.8.13.tar.xz || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    rawcpp="$PWD/rawcpp"
    printf '#!/bin/sh\nexec clang -E -x c "$@" -\n' > "$rawcpp"
    chmod 755 "$rawcpp"

    RAWCPP="$rawcpp" \
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libX11-1.8.13" || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
