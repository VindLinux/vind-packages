src="libfontenc-1.1.9"

pkg_download()
{
    fetch_source libfontenc-1.1.9.tar.xz || exit 1
    tar -xf libfontenc-1.1.9.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libfontenc-1.1.9"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
