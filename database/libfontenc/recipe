src="libfontenc-1.1.9"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libfontenc-1.1.9.tar.xz https://www.x.org/pub/individual/lib/libfontenc-1.1.9.tar.xz
    tar -xf libfontenc-1.1.9.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libfontenc-1.1.9"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
