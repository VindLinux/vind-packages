src="libpipeline-1.5.8"

pkg_download()
{
    fetch_source libpipeline-1.5.8.tar.gz || exit 1
    tar -xf libpipeline-1.5.8.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
