src="krb5-${PKG_VERSION}"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src/src" || exit 1

    set -- --prefix="$PREFIX" --sysconfdir=/etc --localstatedir=/var \
        --without-tcl --without-system-verto

    if attr_on ldap; then
        set -- "$@" --with-ldap
    else
        set -- "$@" --without-ldap
    fi

    if attr_on lmdb; then
        set -- "$@" --with-lmdb
    else
        set -- "$@" --without-lmdb
    fi

    if attr_on readline; then
        set -- "$@" --with-readline
    else
        set -- "$@" --without-readline
    fi

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    if ! attr_on pkinit; then
        set -- "$@" --disable-pkinit
    fi

    if ! attr_on static; then
        set -- "$@" --disable-static
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src/src" || exit 1
    make DESTDIR="$DESTDIR" install
}
