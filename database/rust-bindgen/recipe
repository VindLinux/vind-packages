src="rust-bindgen-0.72.1"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o rust-bindgen-0.72.1.tar.gz https://github.com/rust-lang/rust-bindgen/archive/refs/tags/v0.72.1/rust-bindgen-0.72.1.tar.gz
    tar -xf rust-bindgen-0.72.1.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    cargo build --release --locked
}

pkg_install()
{
    install -Dm755 "$src/target/release/bindgen" "$DESTDIR$PREFIX/bin/bindgen"
    mkdir -p "$DESTDIR$PREFIX/share/bash-completion/completions" "$DESTDIR$PREFIX/share/zsh/site-functions"
    "$src/target/release/bindgen" --generate-shell-completions bash > "$DESTDIR$PREFIX/share/bash-completion/completions/bindgen"
    "$src/target/release/bindgen" --generate-shell-completions zsh > "$DESTDIR$PREFIX/share/zsh/site-functions/_bindgen"
}
