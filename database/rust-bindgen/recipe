src="rust-bindgen-0.72.1"

pkg_download()
{
    fetch_source rust-bindgen-0.72.1.tar.gz || exit 1
    tar -xf rust-bindgen-0.72.1.tar.gz || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    export RUSTFLAGS="-C target-feature=-crt-static"

    cargo build --release --locked || exit 1
}

pkg_install()
{
    install -Dm755 "$src/target/release/bindgen" "$DESTDIR$PREFIX/bin/bindgen" || exit 1
    mkdir -p "$DESTDIR$PREFIX/share/bash-completion/completions" "$DESTDIR$PREFIX/share/zsh/site-functions"
    "$src/target/release/bindgen" --generate-shell-completions bash > "$DESTDIR$PREFIX/share/bash-completion/completions/bindgen" || exit 1
    "$src/target/release/bindgen" --generate-shell-completions zsh > "$DESTDIR$PREFIX/share/zsh/site-functions/_bindgen" || exit 1
}
