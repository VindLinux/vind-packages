src="libXcursor-1.2.3"

pkg_download()
{
    fetch_source libXcursor-1.2.3.tar.xz || exit 1
    tar -xf libXcursor-1.2.3.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXcursor-1.2.3"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
