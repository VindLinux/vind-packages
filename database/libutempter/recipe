src="libutempter-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src/libutempter" || exit 1

    make $MAKEOPTS LINK_STATS= \
        libdir="$PREFIX/lib" libexecdir="$PREFIX/lib" \
        includedir="$PREFIX/include" mandir="$PREFIX/share/man" || exit 1
}

pkg_install()
{
    cd "$src/libutempter" || exit 1

    make DESTDIR="$DESTDIR" \
        libdir="$PREFIX/lib" libexecdir="$PREFIX/lib" \
        includedir="$PREFIX/include" mandir="$PREFIX/share/man" \
        install || exit 1

    helper="$DESTDIR$PREFIX/lib/utempter/utempter"
    if [ -f "$helper" ]; then
        if grep -q '^utmp:' /etc/group; then
            chgrp utmp "$helper" || exit 1
            chmod 2711 "$helper" || exit 1
        else
            chmod 0755 "$helper" || exit 1
        fi
    fi
}
