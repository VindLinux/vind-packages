src="glibc-$PKG_VERSION"
build="$src-build"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://ftp.gnu.org/gnu/glibc/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    mkdir -p "$build" || exit 1
    cd "$build" || exit 1

    set -- --prefix="$PREFIX" --disable-werror --enable-kernel=4.14

    if attr_on systemtap; then
        set -- "$@" --enable-systemtap
    fi

    "../$src/configure" "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$build" || exit 1
    make DESTDIR="$DESTDIR" install
}
