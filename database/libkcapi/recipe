src="libkcapi-${PKG_VERSION}"
tarball="libkcapi_${PKG_VERSION}.orig.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    autoreconf -fi || exit 1
    ./configure --prefix="$PREFIX" --disable-werror || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
