src="libSM-1.2.6"

pkg_download()
{
    fetch_source libSM-1.2.6.tar.xz || exit 1
    tar -xf libSM-1.2.6.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libSM-1.2.6"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
