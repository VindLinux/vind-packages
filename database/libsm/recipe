src="libSM-1.2.6"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libSM-1.2.6.tar.xz https://www.x.org/pub/individual/lib/libSM-1.2.6.tar.xz
    tar -xf libSM-1.2.6.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libSM-1.2.6"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
