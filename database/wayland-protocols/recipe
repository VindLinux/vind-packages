src="wayland-protocols-1.49"

pkg_download()
{
    fetch_source wayland-protocols-1.49.tar.xz || exit 1
    tar -xf wayland-protocols-1.49.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Dtests=false
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
