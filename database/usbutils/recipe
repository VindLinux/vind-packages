src="usbutils-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://mirrors.edge.kernel.org/pub/linux/utils/usb/usbutils/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --libdir="$PREFIX/lib" --buildtype=release --wrap-mode=nodownload -D udevdir="$PREFIX/lib/udev" || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
