src="pulseaudio-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://freedesktop.org/software/pulseaudio/releases/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir=lib --buildtype=release \
           --wrap-mode=nodownload \
           -Dtests=false -Ddoxygen=false -Dman=false \
           -Dbashcompletiondir=no -Dzshcompletiondir=no \
           -Dasyncns=disabled -Davahi=disabled -Dbluez5=disabled \
           -Dbluez5-gstreamer=disabled -Dconsolekit=disabled \
           -Delogind=disabled -Dfftw=disabled -Dgsettings=disabled \
           -Dgstreamer=disabled -Dgtk=disabled -Djack=disabled \
           -Dlirc=disabled -Dopenssl=disabled -Dorc=disabled \
           -Doss-output=disabled -Dsamplerate=disabled -Dsoxr=disabled \
           -Dspeex=disabled -Dsystemd=disabled -Dtcpwrap=disabled \
           -Dvalgrind=disabled -Dx11=disabled -Dwebrtc-aec=disabled \
           -Dglib=enabled -Ddatabase=gdbm

    if attr_on daemon; then
        set -- "$@" -Ddaemon=true -Ddbus=enabled -Dudev=enabled \
               -Dudevrulesdir="$PREFIX/lib/udev/rules.d"
    else
        set -- "$@" -Ddaemon=false -Ddbus=disabled -Dudev=disabled
    fi

    if attr_on alsa; then
        set -- "$@" -Dalsa=enabled
    else
        set -- "$@" -Dalsa=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
