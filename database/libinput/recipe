src="libinput-1.31.0"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libinput-1.31.0.tar.xz https://gitlab.freedesktop.org/libinput/libinput/-/archive/1.31.0/libinput-1.31.0.tar.gz
    tar -xf libinput-1.31.0.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" \
        --prefix="$PREFIX" \
        --buildtype=release \
        -Dlibwacom=false \
        -Ddebug-gui=false \
        -Dtests=false \
        -Ddocumentation=false

    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
