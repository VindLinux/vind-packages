src="libinput-1.31.0"

pkg_download()
{
    fetch_source libinput-1.31.0.tar.xz || exit 1
    tar -xf libinput-1.31.0.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" \
        --prefix="$PREFIX" \
        --buildtype=release \
        -Dlibwacom=false \
        -Ddebug-gui=false \
        -Dtests=false \
        -Ddocumentation=false

    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
