src="swaybg-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/swaywm/swaybg/releases/download/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --buildtype=release

    if attr_on pixbuf; then
        set -- "$@" -Dgdk-pixbuf=enabled
    else
        set -- "$@" -Dgdk-pixbuf=disabled
    fi

    if attr_on man; then
        set -- "$@" -Dman-pages=enabled
    else
        set -- "$@" -Dman-pages=disabled
    fi

    meson setup build "$@" || exit 1
    meson compile -C build || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
