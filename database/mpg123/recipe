src="mpg123-$PKG_VERSION"
tarball="$src.tar.bz2"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://www.mpg123.de/download/$tarball" || exit 1

    bzip2 -t "$tarball" || { rm -f "$tarball"; exit 1; }
    bzip2 -dc "$tarball" | tar -xf - || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    ./configure --prefix="$PREFIX" \
                --disable-components --enable-libmpg123 || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
