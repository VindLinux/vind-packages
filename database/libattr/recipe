src="attr-${PKG_VERSION}"
tarball="${src}.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://download.savannah.gnu.org/releases/attr/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --sysconfdir=/etc --disable-rpath

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    if ! attr_on restorewarn; then
        set -- "$@" --disable-unsafe-restore-warnings
    fi

    if attr_on debug; then
        set -- "$@" --enable-debug
    fi

    if ! attr_on static; then
        set -- "$@" --disable-static
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
