src="libxml2-$PKG_VERSION"
tarball="$src.tar.xz"
series="${PKG_VERSION%.*}"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://download.gnome.org/sources/libxml2/$series/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    (cd "$src" && sed -i "/'git'/,+3d" meson.build) || exit 1

    set -- --prefix="$PREFIX" --libdir="$PREFIX/lib" --buildtype=release -D icu=enabled

    if attr_on zlib; then
        set -- "$@" -D zlib=enabled
    fi

    if attr_on history; then
        set -- "$@" -D history=enabled
    fi

    meson setup "$@" "$src/build" "$src" || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install || exit 1
    sed -i 's/--static/--shared/' "$DESTDIR$PREFIX/bin/xml2-config"
}
