src="mako-$PKG_VERSION"
tarball="mako-$PKG_VERSION.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir=lib --buildtype=release \
           --wrap-mode=nodownload -Dsd-bus-provider=basu

    if attr_on icons; then
        set -- "$@" -Dicons=enabled
    else
        set -- "$@" -Dicons=disabled
    fi

    if attr_on man; then
        set -- "$@" -Dman-pages=enabled
    else
        set -- "$@" -Dman-pages=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
