commit="19f9580f27aa261ea383b395fdef7e153f3f9e6d"
src="itstool-$commit"
tarball="$src.tar.gz"
patchfile="itstool-2.0.7-switch-to-lxml.patch.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/itstool/itstool/archive/$commit.tar.gz" || exit 1
    curl -fL --retry 3 --retry-delay 2 -o "$patchfile" \
        "https://dev.gentoo.org/~sam/distfiles/dev-util/itstool/$patchfile" || exit 1

    tar -xf "$tarball" || exit 1
    xz -dc "$patchfile" > "$src.patch" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    patch -Np1 -i "../$src.patch" || exit 1

    PYTHON="$(command -v python3)" ./autogen.sh --prefix="$PREFIX" || exit 1

    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
