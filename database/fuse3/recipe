src="fuse-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/libfuse/libfuse/releases/download/fuse-$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    # useroot=false: o script de instalacao tentaria chown/setuid dentro do DESTDIR
    # initscriptdir vazio: nao instala script de init
    # io_uring desligado: exigiria liburing e numa
    set -- --prefix="$PREFIX" --libdir=lib --sysconfdir=/etc --buildtype=release \
        -Dutils=true -Dexamples=false -Dtests=false \
        -Duseroot=false -Dinitscriptdir= -Denable-io-uring=false

    CPPFLAGS="$CPPFLAGS -I$PREFIX/include" \
    LDFLAGS="$LDFLAGS -L$PREFIX/lib" \
    meson setup build "$@" || exit 1

    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1

    # o fusermount3 precisa ser setuid para montar sem root
    chmod u+s "$DESTDIR$PREFIX/bin/fusermount3" || exit 1
}
