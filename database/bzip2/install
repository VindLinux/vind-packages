mkdir -p "$DESTDIR$PREFIX/bin" "$DESTDIR$PREFIX/lib" "$DESTDIR$PREFIX/include" "$DESTDIR$PREFIX/share/man/man1"
cd bzip2-1.0.8 && cp -v bzip2-shared "$DESTDIR$PREFIX/bin/bzip2"
cd bzip2-1.0.8 && cp -av libbz2.so* "$DESTDIR$PREFIX/lib/"
cd bzip2-1.0.8 && ln -sfv libbz2.so.1.0.8 "$DESTDIR$PREFIX/lib/libbz2.so"
cd bzip2-1.0.8 && cp -v bzlib.h "$DESTDIR$PREFIX/include/"
cd bzip2-1.0.8 && cp -v bzip2.1 "$DESTDIR$PREFIX/share/man/man1/"
cd bzip2-1.0.8 && ln -sfv bzip2 "$DESTDIR$PREFIX/bin/bunzip2"
cd bzip2-1.0.8 && ln -sfv bzip2 "$DESTDIR$PREFIX/bin/bzcat"
