src="vind-runit"

pkg_download()
{
    git clone https://github.com/VindLinux/vind-runit "$src"
}

pkg_install()
{
    cd "$src" || exit 1

    install -D -m 0755 runit/1 "$DESTDIR/etc/runit/1" || exit 1
    install -D -m 0755 runit/2 "$DESTDIR/etc/runit/2" || exit 1
    install -D -m 0755 runit/3 "$DESTDIR/etc/runit/3" || exit 1

    mkdir -p "$DESTDIR/etc/runit/utils" || exit 1
    for f in utils/*; do
        install -D -m 0755 "$f" "$DESTDIR/etc/runit/utils/$(basename "$f")" || exit 1
    done

    mkdir -p "$DESTDIR/etc/service" || exit 1
    for service in service/*; do
        name="$(basename "$service")"
        mkdir -p "$DESTDIR/etc/service/$name" || exit 1
        install -D -m 0755 "$service/run" "$DESTDIR/etc/service/$name/run" || exit 1
    done

    for f in commands/*; do
        install -D -m 0755 "$f" "$DESTDIR$PREFIX/sbin/$(basename "$f")" || exit 1
    done
}
