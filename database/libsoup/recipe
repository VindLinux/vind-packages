src="libsoup-${PKG_VERSION}"
tarball="libsoup-${PKG_VERSION}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --buildtype=release -Dtests=false -Ddocs=disabled -Dvapi=disabled -Dsysprof=disabled -Dautobahn=disabled -Dpkcs11_tests=disabled -Dntlm=disabled -Dzstd=enabled

    if attr_on introspection; then
        set -- "$@" -Dintrospection=enabled
    else
        set -- "$@" -Dintrospection=disabled
    fi

    if attr_on brotli; then
        set -- "$@" -Dbrotli=enabled
    else
        set -- "$@" -Dbrotli=disabled
    fi

    if attr_on gssapi; then
        set -- "$@" -Dgssapi=enabled
    else
        set -- "$@" -Dgssapi=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
