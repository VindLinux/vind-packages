src="libXaw-1.0.16"

pkg_download()
{
    fetch_source libXaw-1.0.16.tar.xz || exit 1
    tar -xf libXaw-1.0.16.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXaw-1.0.16"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
