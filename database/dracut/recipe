src="dracut-$PKG_VERSION"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "dracut-$PKG_VERSION.tar.gz" "https://github.com/dracut-ng/dracut/archive/refs/tags/$PKG_VERSION.tar.gz"
    tar -xf "dracut-$PKG_VERSION.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --disable-documentation
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
