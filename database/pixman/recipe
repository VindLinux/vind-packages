src="pixman-0.46.4"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o pixman-0.46.4.tar.gz https://www.cairographics.org/releases/pixman-0.46.4.tar.gz
    tar -xf pixman-0.46.4.tar.gz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Dtests=disabled
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
