src="cpio-$PKG_VERSION"

pkg_download()
{
    fetch_source "cpio-$PKG_VERSION.tar.gz" || exit 1
    tar -xf "cpio-$PKG_VERSION.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1

    mt_flag="--disable-mt"
    if attr_on mt; then
        mt_flag="--enable-mt"
    fi

    CFLAGS="-std=gnu17 $CFLAGS" ./configure --prefix="$PREFIX" $mt_flag
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
