tarball="JetBrainsMono-${PKG_VERSION}.zip"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    mkdir -p src && unzip -oq "$tarball" -d src || exit 1
}

pkg_build()
{
    :
}

pkg_install()
{
    mkdir -p "$DESTDIR$PREFIX/share/fonts/TTF"
    cp src/fonts/ttf/*.ttf "$DESTDIR$PREFIX/share/fonts/TTF/"
}
