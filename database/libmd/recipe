src="libmd-1.2.0"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libmd-1.2.0.tar.xz https://libbsd.freedesktop.org/releases/libmd-1.2.0.tar.xz
    tar -xf libmd-1.2.0.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
