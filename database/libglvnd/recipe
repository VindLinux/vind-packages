src="libglvnd-v$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    meson setup build --prefix="$PREFIX" --libdir=lib --buildtype=release \
        --wrap-mode=nodownload \
        -Dx11=enabled -Dglx=enabled -Degl=true \
        -Dgles1=true -Dgles2=true -Dheaders=true || exit 1

    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
