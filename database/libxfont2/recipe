src="libXfont2-2.0.7"

pkg_download()
{
    fetch_source libXfont2-2.0.7.tar.xz || exit 1
    tar -xf libXfont2-2.0.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXfont2-2.0.7" --disable-devel-docs
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
