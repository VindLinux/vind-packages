src="phc-winner-argon2-${PKG_VERSION}"
tarball="phc-winner-argon2-${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    make $MAKEOPTS PREFIX="$PREFIX" LIBRARY_REL=lib
}

pkg_install()
{
    cd "$src" || exit 1
    make install PREFIX="$PREFIX" DESTDIR="$DESTDIR" LIBRARY_REL=lib
}
