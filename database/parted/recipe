src="parted-3.7"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o parted-3.7.tar.xz https://ftp.gnu.org/gnu/parted/parted-3.7.tar.xz
    tar -xf parted-3.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-nls --disable-device-mapper --without-readline
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
