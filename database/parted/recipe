src="parted-3.7"

pkg_download()
{
    fetch_source parted-3.7.tar.xz || exit 1
    tar -xf parted-3.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-nls --disable-device-mapper --without-readline
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
