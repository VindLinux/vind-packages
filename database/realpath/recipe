src="coreutils-9.7"

pkg_download()
{
    fetch_source coreutils-9.7.tar.xz || exit 1
    tar -xf coreutils-9.7.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" FORCE_UNSAFE_CONFIGURE=1
    make $MAKEOPTS
}

pkg_install()
{
    mkdir -p "$DESTDIR$PREFIX/bin"
    cp -v "$src/src/realpath" "$DESTDIR$PREFIX/bin/realpath"
}
