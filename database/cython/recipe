src="cython-$PKG_VERSION"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "cython-$PKG_VERSION.tar.gz" "https://github.com/cython/cython/releases/download/$PKG_VERSION/cython-$PKG_VERSION.tar.gz"
    tar -xf "cython-$PKG_VERSION.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1
    pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "$PWD"
}

pkg_install()
{
    cd "$src" || exit 1
    pip3 install --break-system-packages --no-index --find-links dist --no-user --root="$DESTDIR" --prefix="$PREFIX" Cython
}
