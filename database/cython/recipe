src="cython-$PKG_VERSION"

pkg_download()
{
    fetch_source "cython-$PKG_VERSION.tar.gz" || exit 1
    tar -xf "cython-$PKG_VERSION.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1
    pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "$PWD"
}

pkg_install()
{
    cd "$src" || exit 1
    pip3 install --break-system-packages --no-index --find-links dist --no-user --root="$DESTDIR" --prefix="$PREFIX" Cython
}
