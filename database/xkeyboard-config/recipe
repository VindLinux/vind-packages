src="xkeyboard-config-2.48"

pkg_download()
{
    fetch_source xkeyboard-config-2.48.tar.xz || exit 1
    tar -xf xkeyboard-config-2.48.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
