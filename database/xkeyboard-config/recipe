src="xkeyboard-config-2.48"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o xkeyboard-config-2.48.tar.xz https://xorg.freedesktop.org/releases/individual/data/xkeyboard-config/xkeyboard-config-2.48.tar.xz
    tar -xf xkeyboard-config-2.48.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
