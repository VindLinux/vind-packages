src="smartmontools-7.4"

pkg_download()
{
    fetch_source smartmontools-7.4.tar.gz || exit 1
    tar -xf smartmontools-7.4.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
