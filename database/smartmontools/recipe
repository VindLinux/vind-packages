src="smartmontools-7.4"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o smartmontools-7.4.tar.gz https://downloads.sourceforge.net/project/smartmontools/smartmontools/7.4/smartmontools-7.4.tar.gz
    tar -xf smartmontools-7.4.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
