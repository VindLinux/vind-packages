src="libxcb-1.17.0"

pkg_download()
{
    fetch_source libxcb-1.17.0.tar.xz || exit 1
    tar -xf libxcb-1.17.0.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --without-doxygen --docdir="$XORG_PREFIX/share/doc/libxcb-1.17.0"
    LC_ALL=en_US.UTF-8 make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
