src="libevdev-1.13.7"

pkg_download()
{
    fetch_source libevdev-1.13.7.tar.xz || exit 1
    tar -xf libevdev-1.13.7.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" \
        --prefix="$PREFIX" \
        --buildtype=release \
        -Ddocumentation=disabled \
        -Dtests=disabled

    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
