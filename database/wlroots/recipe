src="wlroots-0.20.1"

pkg_download()
{
    fetch_source wlroots-0.20.1.tar.gz || exit 1
    tar -xf wlroots-0.20.1.tar.gz
}

pkg_build()
{
    xwayland="disabled"
    
	if attr_on xwayland; then
        xwayland="enabled"
    fi

    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Dexamples=false -Dxwayland="$xwayland" || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
