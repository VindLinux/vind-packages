src="wlroots-0.20.1"

pkg_download()
{
    fetch_source wlroots-0.20.1.tar.gz || exit 1
    tar -xf wlroots-0.20.1.tar.gz
}

pkg_build()
{
    xwayland="disabled"
    renderers=""
    allocators="udmabuf"

    if attr_on xwayland; then
        xwayland="enabled"
    fi

    if attr_on egl; then
        renderers="gles2"
    fi

    if attr_on vulkan; then
        renderers="${renderers:+$renderers,}vulkan"
    fi

    if attr_on gbm; then
        allocators="$allocators,gbm"
    fi

    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release \
        -Dexamples=false -Dxwayland="$xwayland" \
        -Drenderers="$renderers" -Dallocators="$allocators" || exit 1
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
