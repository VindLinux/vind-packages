src="wlroots-0.20.1"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o wlroots-0.20.1.tar.gz https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/0.20.1/downloads/wlroots-0.20.1.tar.gz
    tar -xf wlroots-0.20.1.tar.gz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Dexamples=false -Dxwayland=enabled
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
