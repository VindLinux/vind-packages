src="pango-${PKG_VERSION}"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

feat()
{
    if attr_on "$1"; then
        mopts="$mopts -D$2=enabled"
    else
        mopts="$mopts -D$2=disabled"
    fi
}

pkg_build()
{
    cd "$src" || exit 1

    sed -i 's|^#include "config.h"|&\n#include <fontconfig/fontconfig.h>\n#include <fontconfig/fcfreetype.h>|' pango/pangofc-fontmap.c || exit 1

    mopts=""

    feat cairo         cairo
    feat freetype      freetype
    feat xft           xft
    feat libthai       libthai
    feat introspection introspection

    meson setup build --prefix="$PREFIX" --libdir=lib --buildtype=release \
        --wrap-mode=nodownload \
        -Dfontconfig=enabled -Dsysprof=disabled \
        -Ddocumentation=false -Dman-pages=false \
        -Dbuild-testsuite=false -Dbuild-examples=false \
        $mopts || exit 1

    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
