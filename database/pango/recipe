src="pango-${PKG_VERSION}"
tarball="pango-${PKG_VERSION}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --buildtype=release -Dfontconfig=enabled -Dfreetype=enabled -Dcairo=enabled -Dbuild-testsuite=false -Dbuild-examples=false

    if attr_on introspection; then
        set -- "$@" -Dintrospection=enabled
    else
        set -- "$@" -Dintrospection=disabled
    fi

    if attr_on xft; then
        set -- "$@" -Dxft=enabled
    else
        set -- "$@" -Dxft=disabled
    fi

    if attr_on libthai; then
        set -- "$@" -Dlibthai=enabled
    else
        set -- "$@" -Dlibthai=disabled
    fi

    meson setup build "$@" || exit 1
    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
