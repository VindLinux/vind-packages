src="limine-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/Limine-Bootloader/Limine/releases/download/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" \
        --enable-bios \
        --enable-bios-cd \
        --enable-uefi-cd \
        --enable-bios-pxe \
        --enable-uefi-ia32 \
        --enable-uefi-x86-64 \
        --docdir="$PREFIX/share/doc/$src"

    if attr_on uefi_aarch64; then
        set -- "$@" --enable-uefi-aarch64
    fi

    if attr_on uefi_riscv64; then
        set -- "$@" --enable-uefi-riscv64
    fi

    if attr_on uefi_loongarch64; then
        set -- "$@" --enable-uefi-loongarch64
    fi

    CC_FOR_TARGET=cc LD_FOR_TARGET=ld OBJCOPY_FOR_TARGET=objcopy OBJDUMP_FOR_TARGET=objdump READELF_FOR_TARGET=readelf ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
