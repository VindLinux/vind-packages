src="nghttp2-1.68.0"

pkg_download()
{
    fetch_source nghttp2-1.68.0.tar.xz || exit 1
    tar -xf nghttp2-1.68.0.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --enable-lib-only --docdir="$PREFIX/share/doc/nghttp2-1.68.0"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
