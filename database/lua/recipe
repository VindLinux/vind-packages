src="lua-${PKG_VERSION}"
tarball="${src}.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://www.lua.org/ftp/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    if attr_on readline; then
        plat="linux-readline"
    else
        plat="linux"
    fi

    make $MAKEOPTS "$plat" CC="${CC:-cc} -std=gnu99" MYCFLAGS="$CFLAGS -fPIC" MYLDFLAGS="$LDFLAGS"
}

pkg_install()
{
    cd "$src" || exit 1

    make install INSTALL_TOP="$DESTDIR$PREFIX" INSTALL_MAN="$DESTDIR$PREFIX/share/man/man1" || exit 1

    mkdir -p "$DESTDIR$PREFIX/lib/pkgconfig" || exit 1

    printf '%s\n' \
        "prefix=$PREFIX" \
        'libdir=${prefix}/lib' \
        'includedir=${prefix}/include' \
        '' \
        'Name: Lua' \
        'Description: An extensible extension language' \
        "Version: $PKG_VERSION" \
        'Libs: -L${libdir} -llua -lm -ldl' \
        'Cflags: -I${includedir}' \
        > "$DESTDIR$PREFIX/lib/pkgconfig/lua.pc"
}
