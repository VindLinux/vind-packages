src="sl-${PKG_VERSION}"
tarball="${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
	tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
	make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
	
	install -m 755 sl "$PREFIX/bin/sl" || exit 1
}
