src="gtk-${PKG_VERSION}"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

opt()
{
    if attr_on "$1"; then
        mopts="$mopts -D$2=true"
    else
        mopts="$mopts -D$2=false"
    fi
}

yn()
{
    if attr_on "$1"; then
        mopts="$mopts -D$2=yes"
    else
        mopts="$mopts -D$2=no"
    fi
}

pkg_build()
{
    cd "$src" || exit 1

    mopts=""

    opt x11           x11_backend
    opt wayland       wayland_backend
    opt broadway      broadway_backend
    opt introspection introspection
    yn  xinerama      xinerama
    yn  colord        colord

    if attr_on cups; then
        mopts="$mopts -Dprint_backends=cups,file,lpr"
    else
        mopts="$mopts -Dprint_backends=file,lpr"
    fi

    meson setup build --prefix="$PREFIX" --libdir=lib --buildtype=release \
        --wrap-mode=nodownload \
        -Dgtk_doc=false -Dman=false -Ddemos=false -Dexamples=false \
        -Dtests=false -Dinstalled_tests=false \
        -Dcloudproviders=false -Dprofiler=false -Dtracker3=false \
        $mopts || exit 1

    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
