cd zlib-1.3.1 || exit 1

# build a static-only library instead of the default static+shared, off by default unless "static" is enabled
static_flag=""
if echo "$COMP_ATTRS" | grep -qw static; then
    static_flag="--static"
fi

# prefix all exported symbols with "z_" to avoid clashing with other zlib copies on the system
zprefix_flag=""
if echo "$COMP_ATTRS" | grep -qw zprefix; then
    zprefix_flag="--zprefix"
fi

./configure --prefix="$PREFIX" $static_flag $zprefix_flag

make $MAKEOPTS
