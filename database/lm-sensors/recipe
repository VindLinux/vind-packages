src="lm-sensors-$(echo "$PKG_VERSION" | tr . -)"
tarball="lm-sensors_${PKG_VERSION}.orig.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    make $MAKEOPTS PREFIX="$PREFIX" MANDIR="$PREFIX/share/man"
}

pkg_install()
{
    cd "$src" || exit 1
    make PREFIX="$PREFIX" MANDIR="$PREFIX/share/man" DESTDIR="$DESTDIR" install
}
