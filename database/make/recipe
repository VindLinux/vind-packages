src="make-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX"

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    if attr_on guile; then
        set -- "$@" --with-guile
    else
        set -- "$@" --without-guile
    fi

    CFLAGS="-std=gnu17 $CFLAGS" ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
