src="systemtap-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://www.sourceware.org/ftp/systemtap/releases/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --disable-server --disable-monitor \
           --disable-libvirt --without-nss --without-openssl \
           --without-avahi --without-selinux --without-bpf \
           --without-libbpf --without-rpm --without-python3-probes \
           --with-debuginfod=no --disable-rpath

    if ! attr_on translator; then
        set -- "$@" --disable-translator
    fi

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
