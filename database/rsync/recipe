src="rsync-$PKG_VERSION"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$src.tar.gz" "https://rsync.samba.org/ftp/rsync/src/$src.tar.gz"
    tar -xf "$src.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1

    ipv6_flag="--disable-ipv6"
    if attr_on ipv6; then
        ipv6_flag="--enable-ipv6"
    fi

    locale_flag="--disable-locale"
    if attr_on locale; then
        locale_flag="--enable-locale"
    fi

    openssl_flag="--disable-openssl"
    if attr_on openssl; then
        openssl_flag="--enable-openssl"
    fi

    xxhash_flag="--disable-xxhash"
    if attr_on xxhash; then
        xxhash_flag="--enable-xxhash"
    fi

    zstd_flag="--disable-zstd"
    if attr_on zstd; then
        zstd_flag="--enable-zstd"
    fi

    lz4_flag="--disable-lz4"
    if attr_on lz4; then
        lz4_flag="--enable-lz4"
    fi

    idn_flag="--disable-idn"
    if attr_on idn; then
        idn_flag="--enable-idn"
    fi

    iconv_flag="--disable-iconv"
    if attr_on iconv; then
        iconv_flag="--enable-iconv"
    fi

    acl_flag="--disable-acl-support"
    if attr_on acl; then
        acl_flag="--enable-acl-support"
    fi

    xattr_flag="--disable-xattr-support"
    if attr_on xattr; then
        xattr_flag="--enable-xattr-support"
    fi

    rrsync_flag=""
    if attr_on rrsync; then
        rrsync_flag="--with-rrsync"
    fi

    ./configure --prefix="$PREFIX" \
        $ipv6_flag $locale_flag $openssl_flag $xxhash_flag $zstd_flag $lz4_flag \
        $idn_flag $iconv_flag $acl_flag $xattr_flag $rrsync_flag

    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
