src="iso-codes-${PKG_VERSION}"
tarball="iso-codes_${PKG_VERSION}.orig.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    meson setup build --prefix="$PREFIX" --buildtype=release || exit 1
    ninja -C build $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install
}
