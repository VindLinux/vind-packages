src="efibootmgr-$PKG_VERSION"

pkg_download()
{
    fetch_source "efibootmgr-$PKG_VERSION.tar.gz" || exit 1
    tar -xf "efibootmgr-$PKG_VERSION.tar.gz"
}

pkg_build()
{
    cd "$src" || exit 1
    make EFIDIR=LFS EFI_LOADER=grubx64.efi
}

pkg_install()
{
    cd "$src" || exit 1
    make install EFIDIR=LFS
}
