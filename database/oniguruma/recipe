src="onig-6.9.10"

pkg_download()
{
    fetch_source onig-6.9.10.tar.gz || exit 1
    tar -xf onig-6.9.10.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --enable-shared
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
