src="cbindgen-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/mozilla/cbindgen/archive/v$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    cargo build --release --locked
}

pkg_install()
{
    cd "$src" || exit 1
    install -Dm755 target/release/cbindgen "$DESTDIR$PREFIX/bin/cbindgen"
}
