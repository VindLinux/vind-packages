src="jack2-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    python3 ./waf configure --prefix="$PREFIX" --libdir="$PREFIX/lib" \
        --mandir="$PREFIX/share/man" || exit 1
    python3 ./waf build || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    python3 ./waf install --destdir="$DESTDIR" || exit 1
}
