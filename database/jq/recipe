src="jq-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/jqlang/jq/releases/download/jq-$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-maintainer-mode --disable-docs --with-oniguruma=yes || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    make -C "$src" DESTDIR="$DESTDIR" install
}
