src="xeyes-${PKG_VERSION}"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX"

    if attr_on xrender; then
        set -- "$@" --with-xrender
    else
        set -- "$@" --without-xrender
    fi

    if attr_on present; then
        set -- "$@" --with-present
    else
        set -- "$@" --without-present
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
