src="scdoc-1.11.3"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o scdoc-1.11.3.tar.gz https://git.sr.ht/~sircmpwn/scdoc/archive/1.11.3.tar.gz
    tar -xf scdoc-1.11.3.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" PREFIX="$PREFIX" install
}
