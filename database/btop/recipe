src="btop-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/aristocratos/btop/archive/refs/tags/v$PKG_VERSION.tar.gz" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    gpu="false"
    if attr_on gpu; then
        gpu="true"
    fi

    make -C "$src" GPU_SUPPORT="$gpu" $MAKEOPTS
}

pkg_install()
{
    gpu="false"
    if attr_on gpu; then
        gpu="true"
    fi

    make -C "$src" GPU_SUPPORT="$gpu" PREFIX="$PREFIX" DESTDIR="$DESTDIR" install
}
