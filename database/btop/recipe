src="btop-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    gpu="false"
    if attr_on gpu; then
        gpu="true"
    fi

    make -C "$src" GPU_SUPPORT="$gpu" $MAKEOPTS
}

pkg_install()
{
    gpu="false"
    if attr_on gpu; then
        gpu="true"
    fi

    make -C "$src" GPU_SUPPORT="$gpu" PREFIX="$PREFIX" DESTDIR="$DESTDIR" install
}
