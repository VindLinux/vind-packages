src="m4-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://ftp.gnu.org/gnu/m4/$tarball" || \
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://mirrors.kernel.org/gnu/m4/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX"

    if attr_on changeword; then
        set -- "$@" --enable-changeword
    fi

    if attr_on libsigsegv; then
        set -- "$@" --with-libsigsegv
    else
        set -- "$@" --without-libsigsegv
    fi

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
