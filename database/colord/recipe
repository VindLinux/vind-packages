src="colord-${PKG_VERSION}"
tarball="${src}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir=lib --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release -Dsystemd=false -Dtests=false -Ddocs=false -Dman=false \
        -Ddaemon_user=colord

    for opt in bash_completion introspection; do
        if attr_on "$opt"; then
            set -- "$@" -D"$opt"=true
        else
            set -- "$@" -D"$opt"=false
        fi
    done

    meson setup builddir "$@" || exit 1
    ninja -C builddir $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C builddir --no-rebuild
}
