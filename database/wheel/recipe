whl="wheel-${PKG_VERSION}-py3-none-any.whl"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$whl" \
        "https://files.pythonhosted.org/packages/py3/w/wheel/$whl" || exit 1
}

pkg_build()
{
    :
}

pkg_install()
{
    site=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib', vars={'base': '$PREFIX', 'platbase': '$PREFIX'}))") || exit 1

    mkdir -p "$DESTDIR$site" "$DESTDIR$PREFIX/bin"
    python3 -m zipfile -e "$whl" "$DESTDIR$site" || exit 1

    printf '#!/bin/sh\nexec python3 -m wheel "$@"\n' > "$DESTDIR$PREFIX/bin/wheel"
    chmod 755 "$DESTDIR$PREFIX/bin/wheel"
}
