src="markupsafe-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://files.pythonhosted.org/packages/source/m/markupsafe/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
}

pkg_install()
{
    cd "$src" || exit 1
    pip3 install --no-index --find-links dist --no-cache-dir --ignore-installed --root="$DESTDIR" --prefix="$PREFIX" MarkupSafe
}
