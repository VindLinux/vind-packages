src="libevent-2.1.13-stable"

pkg_download()
{
    fetch_source libevent-2.1.13-stable.tar.gz || exit 1
    tar -xf libevent-2.1.13-stable.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
