src="libsepol-${PKG_VERSION}"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

setopts()
{
    mkopts="PREFIX=$PREFIX LIBDIR=$PREFIX/lib SHLIBDIR=$PREFIX/lib"

    if ! attr_on shared; then
        mkopts="$mkopts DISABLE_SHARED=y"
    fi

    if ! attr_on cil; then
        mkopts="$mkopts DISABLE_CIL=y"
    fi
}

pkg_build()
{
    cd "$src" || exit 1

    setopts

    make $mkopts $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1

    setopts

    make $mkopts DESTDIR="$DESTDIR" install
}
