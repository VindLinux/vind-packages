src="SDL2-${PKG_VERSION}"
tarball="SDL2-${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --disable-video-rpi --disable-video-vivante --disable-video-directfb --disable-jack --disable-esd --disable-arts --disable-nas --disable-fusionsound --disable-libsamplerate --disable-ibus --disable-hidapi-libusb

    for a in x11 wayland kmsdrm; do
        if attr_on "$a"; then
            set -- "$@" --enable-video-"$a"
        else
            set -- "$@" --disable-video-"$a"
        fi
    done

    for a in alsa pulseaudio pipewire sndio; do
        if attr_on "$a"; then
            set -- "$@" --enable-"$a"
        else
            set -- "$@" --disable-"$a"
        fi
    done

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
