src="expat-$PKG_VERSION"
tarball="$src.tar.xz"
tag="R_$(printf '%s' "$PKG_VERSION" | tr . _)"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- $XORG_CONFIG

    if attr_on xml_attr_info; then
        set -- "$@" --enable-xml-attr-info
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
