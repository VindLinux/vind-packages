src="byacc-${PKG_VERSION}"
tarball="byacc-${PKG_VERSION}.tgz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://invisible-mirror.net/archives/byacc/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    ./configure --prefix="$PREFIX" \
                --program-transform-name='s/^yacc$/byacc/' \
                --disable-echo || exit 1

    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
