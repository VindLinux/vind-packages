src="sndio-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://sndio.org/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir="$PREFIX/lib" \
           --mandir="$PREFIX/share/man" --without-libbsd

    if attr_on alsa; then
        set -- "$@" --enable-alsa
    else
        set -- "$@" --disable-alsa
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install || exit 1
}
