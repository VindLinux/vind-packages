src="libxslt-${PKG_VERSION}"
tarball="${src}.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --without-python --without-debug

    if attr_on crypto; then
        set -- "$@" --with-crypto
    else
        set -- "$@" --without-crypto
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
