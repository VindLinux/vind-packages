src="wireplumber-${PKG_VERSION}"
tarball="${src}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --libdir=lib --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release \
        -Dsystem-lua=true -Dsystemd=disabled -Delogind=disabled \
        -Dsystemd-system-service=false -Dsystemd-user-service=false \
        -Dtests=false -Ddbus-tests=false

    if attr_on introspection; then
        set -- "$@" -Dintrospection=enabled
    else
        set -- "$@" -Dintrospection=disabled
    fi

    if attr_on docs; then
        set -- "$@" -Ddoc=enabled
    else
        set -- "$@" -Ddoc=disabled
    fi

    PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig:$PREFIX/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
    CPPFLAGS="$CPPFLAGS -I$PREFIX/include" \
    LDFLAGS="$LDFLAGS -L$PREFIX/lib" \
    LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    meson setup build "$@" || exit 1

    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" meson install -C build || exit 1
}
