src="efivar-$PKG_VERSION"
tarball="$src.tar.gz"
patchfile="$src-upstream_fixes-1.patch"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/rhboot/efivar/archive/$PKG_VERSION/$tarball" || exit 1
    curl -fL --retry 3 --retry-delay 2 -o "$patchfile" \
        "https://www.linuxfromscratch.org/patches/blfs/13.0/$patchfile" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    patch -Np1 -i "../$patchfile" || exit 1
    make ENABLE_DOCS=0
}

pkg_install()
{
    cd "$src" || exit 1
    make install ENABLE_DOCS=0 LIBDIR="$PREFIX/lib" DESTDIR="$DESTDIR" || exit 1
    install -Dm644 docs/efivar.1 "$DESTDIR$PREFIX/share/man/man1/efivar.1" || exit 1
    mkdir -p "$DESTDIR$PREFIX/share/man/man3" || exit 1
    install -m644 docs/*.3 "$DESTDIR$PREFIX/share/man/man3/"
}
