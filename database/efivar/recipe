src="efivar-39"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 \
        -o efivar-39.tar.gz \
        "https://github.com/rhboot/efivar/archive/39/efivar-39.tar.gz"

    curl -fL --retry 3 --retry-delay 2 \
        -o efivar-39-upstream_fixes-1.patch \
        "https://www.linuxfromscratch.org/patches/blfs/13.0/efivar-39-upstream_fixes-1.patch"

    tar -xf efivar-39.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    patch -Np1 -i ../efivar-39-upstream_fixes-1.patch
    make ENABLE_DOCS=0
}

pkg_install()
{
    cd "$src" || exit 1

    make install \
        ENABLE_DOCS=0 \
        LIBDIR="$PREFIX/lib" \
        DESTDIR="$DESTDIR"

    install -Dm644 \
        docs/efivar.1 \
        "$DESTDIR$PREFIX/share/man/man1/efivar.1"

    mkdir -p "$DESTDIR$PREFIX/share/man/man3"
    install -m644 \
        docs/*.3 \
        "$DESTDIR$PREFIX/share/man/man3/"
}
