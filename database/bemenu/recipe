src="bemenu-$PKG_VERSION"
tarball="bemenu-$PKG_VERSION.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- clients wayland

    if attr_on curses; then
        set -- "$@" curses
    fi

    if attr_on x11; then
        set -- "$@" x11
    fi

    make $MAKEOPTS PREFIX="$PREFIX" libdir="$PREFIX/lib" "$@" || exit 1
}

pkg_install()
{
    cd "$src" || exit 1

    set -- install-base install-wayland

    if attr_on curses; then
        set -- "$@" install-curses
    fi

    if attr_on x11; then
        set -- "$@" install-x11
    fi

    make DESTDIR="$DESTDIR" PREFIX="$PREFIX" libdir="$PREFIX/lib" "$@" || exit 1
}
