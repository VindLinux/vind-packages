src="wayland-1.26.0"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o wayland-1.26.0.tar.xz https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.26.0/downloads/wayland-1.26.0.tar.xz
    tar -xf wayland-1.26.0.tar.xz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release -Ddocumentation=false -Dtests=false -Ddtd_validation=false
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
