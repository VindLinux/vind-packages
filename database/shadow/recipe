src="shadow-4.17.1"

pkg_download()
{
    fetch_source shadow-4.17.1.tar.gz || exit 1
    tar -xf shadow-4.17.1.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --without-audit --without-selinux --without-acl --without-attr --disable-nls --without-libbsd
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
