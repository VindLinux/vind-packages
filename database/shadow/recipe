src="shadow-4.17.1"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o shadow-4.17.1.tar.gz https://github.com/shadow-maint/shadow/releases/download/4.17.1/shadow-4.17.1.tar.gz
    tar -xf shadow-4.17.1.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --without-audit --without-selinux --without-acl --without-attr --disable-nls --without-libbsd
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
