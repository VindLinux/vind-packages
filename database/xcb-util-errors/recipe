src="xcb-util-errors-1.0.1"

pkg_download()
{
    fetch_source xcb-util-errors-1.0.1.tar.xz || exit 1
    tar -xf xcb-util-errors-1.0.1.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
