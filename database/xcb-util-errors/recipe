src="xcb-util-errors-1.0.1"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o xcb-util-errors-1.0.1.tar.xz https://xcb.freedesktop.org/dist/xcb-util-errors-1.0.1.tar.xz
    tar -xf xcb-util-errors-1.0.1.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
