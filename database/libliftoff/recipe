src="libliftoff-v0.5.0"

pkg_download()
{
    fetch_source libliftoff-0.5.0.tar.gz || exit 1
    tar -xf libliftoff-0.5.0.tar.gz
}

pkg_build()
{
    meson setup "$src/build" "$src" --prefix="$PREFIX" --buildtype=release
    ninja -C "$src/build" $MAKEOPTS
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install
}
