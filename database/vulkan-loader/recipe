src="Vulkan-Loader-$PKG_VERSION"
tarball="vulkan-loader-$PKG_VERSION.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/v$PKG_VERSION.tar.gz" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    if attr_on x11; then
        x11=ON
    else
        x11=OFF
    fi

    cmake -G Ninja -S . -B build \
        -D CMAKE_INSTALL_PREFIX="$PREFIX" \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_SKIP_INSTALL_RPATH=ON \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTS=OFF \
        -D BUILD_WSI_WAYLAND_SUPPORT=ON \
        -D BUILD_WSI_XCB_SUPPORT="$x11" \
        -D BUILD_WSI_XLIB_SUPPORT="$x11" \
        -D BUILD_WSI_XLIB_XRANDR_SUPPORT="$x11" \
        -W no-dev || exit 1

    ninja -C build $MAKEOPTS || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    DESTDIR="$DESTDIR" ninja -C build install || exit 1
}
