src="wget-1.25.0"

pkg_download()
{
    fetch_source wget-1.25.0.tar.gz || exit 1
    tar -xf wget-1.25.0.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --with-ssl=openssl
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
