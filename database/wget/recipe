src="wget-1.25.0"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o wget-1.25.0.tar.gz https://ftp.gnu.org/gnu/wget/wget-1.25.0.tar.gz
    tar -xf wget-1.25.0.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --with-ssl=openssl
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
