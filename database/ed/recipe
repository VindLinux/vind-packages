src="ed-$PKG_VERSION"

pkg_download()
{
    fetch_source "ed-$PKG_VERSION.tar.lz" || exit 1
    bsdtar -xf "ed-$PKG_VERSION.tar.lz"
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
