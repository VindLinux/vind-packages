src="popt-1.19"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o popt-1.19.tar.gz https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-1.19.tar.gz
    tar -xf popt-1.19.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static
    make
}

pkg_install()
{
    cd "$src" || exit 1
    make install DESTDIR="$DESTDIR"
}
