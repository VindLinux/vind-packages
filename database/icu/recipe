src="icu/source"
tarball="icu4c-$PKG_VERSION-sources.tgz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/unicode-org/icu/releases/download/release-$PKG_VERSION/$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
