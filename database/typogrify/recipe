src="typogrify-${PKG_VERSION}"
tarball="typogrify-${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_install()
{
    cd "$src" || exit 1
    site=$(python3 -c 'import sys, sysconfig; print(sysconfig.get_path("purelib", vars={"base": sys.argv[1], "platbase": sys.argv[1]}))' "$PREFIX") || exit 1
    mkdir -p "$DESTDIR$site" || exit 1
    cp -R typogrify "$DESTDIR$site/"
}
