src="libffi-3.5.2"

pkg_download()
{
    fetch_source libffi-3.5.2.tar.gz || exit 1
    tar -xf libffi-3.5.2.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --with-gcc-arch=native
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
