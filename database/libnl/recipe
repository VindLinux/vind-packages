src="libnl-3.12.0"

pkg_download()
{
    fetch_source libnl-3.12.0.tar.gz || exit 1
    tar -xf libnl-3.12.0.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --disable-static
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
