src="libnl-3.12.0"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libnl-3.12.0.tar.gz https://github.com/thom311/libnl/releases/download/libnl3_12_0/libnl-3.12.0.tar.gz
    tar -xf libnl-3.12.0.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --disable-static
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
