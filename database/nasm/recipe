src="nasm-3.01"

pkg_download()
{
    fetch_source nasm-3.01.tar.xz || exit 1
    tar -xf nasm-3.01.tar.xz
}

pkg_build()
{
    sed -i 's/-std=c23//' "$src/configure"
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
