src="nasm-3.01"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o nasm-3.01.tar.xz https://www.nasm.us/pub/nasm/releasebuilds/3.01/nasm-3.01.tar.xz
    tar -xf nasm-3.01.tar.xz
}

pkg_build()
{
    sed -i 's/-std=c23//' "$src/configure"
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
