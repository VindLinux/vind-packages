src="libbpf-${PKG_VERSION}/src"
tarball="libbpf_${PKG_VERSION}.orig.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    make $MAKEOPTS PREFIX="$PREFIX" LIBDIR="$PREFIX/lib"
}

pkg_install()
{
    cd "$src" || exit 1
    make PREFIX="$PREFIX" LIBDIR="$PREFIX/lib" DESTDIR="$DESTDIR" install
}
