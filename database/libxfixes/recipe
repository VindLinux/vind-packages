src="libXfixes-6.0.2"

pkg_download()
{
    fetch_source libXfixes-6.0.2.tar.xz || exit 1
    tar -xf libXfixes-6.0.2.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXfixes-6.0.2"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
