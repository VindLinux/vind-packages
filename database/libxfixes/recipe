src="libXfixes-6.0.2"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libXfixes-6.0.2.tar.xz https://www.x.org/pub/individual/lib/libXfixes-6.0.2.tar.xz
    tar -xf libXfixes-6.0.2.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure $XORG_CONFIG --docdir="$XORG_PREFIX/share/doc/libXfixes-6.0.2"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
