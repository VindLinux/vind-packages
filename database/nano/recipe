src="nano-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    set -- --prefix="$PREFIX" --sysconfdir=/etc --enable-utf8

    if ! attr_on nls; then
        set -- "$@" --disable-nls
    fi

    if ! attr_on libmagic; then
        set -- "$@" --disable-libmagic
    fi

    if attr_on tiny; then
        set -- "$@" --enable-tiny
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
