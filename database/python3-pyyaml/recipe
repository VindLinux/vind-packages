src="pyyaml-6.0.3"

pkg_download()
{
    fetch_source pyyaml-6.0.3.tar.gz || exit 1
    tar -xf pyyaml-6.0.3.tar.gz
}

pkg_build()
{
    cd "$src" || exit 1
    pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "$PWD"
}

pkg_install()
{
    cd "$src" || exit 1
    pip3 install --break-system-packages --no-index --find-links dist --no-user --root="$DESTDIR" --prefix="$PREFIX" PyYAML
}
