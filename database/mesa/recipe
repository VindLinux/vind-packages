src="mesa-$PKG_VERSION"
tarball="$src.tar.xz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    gallium="llvmpipe"
    vulkan=""

    if attr_on amdgpu; then
        gallium="$gallium,radeonsi,r600"
        vulkan="${vulkan:+$vulkan,}amd"
    fi

    if attr_on intel; then
        gallium="$gallium,iris"
    fi

    if attr_on anv; then
        vulkan="${vulkan:+$vulkan,}intel"
    fi

    if attr_on nouveau; then
        gallium="$gallium,nouveau"
    fi

    if attr_on r300; then
        gallium="$gallium,r300"
    fi

    if attr_on zink; then
        gallium="$gallium,zink"
    fi

    meson setup "$src/build" "$src" \
        --prefix="$XORG_PREFIX" \
        --libdir="$XORG_PREFIX/lib" \
        --buildtype=release \
        -D platforms=x11,wayland \
        -D gallium-drivers="$gallium" \
        -D vulkan-drivers="$vulkan" \
        -D valgrind=disabled \
        -D video-codecs=all \
        -D libunwind=disabled \
        --wrap-mode=nodownload || exit 1

    ninja -C "$src/build" $MAKEOPTS || exit 1
}

pkg_install()
{
    DESTDIR="$DESTDIR" ninja -C "$src/build" install || exit 1
}
