src="libunistring-1.4.2"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o libunistring-1.4.2.tar.xz https://ftp.gnu.org/gnu/libunistring/libunistring-1.4.2.tar.xz
    tar -xf libunistring-1.4.2.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX" --disable-static --docdir="$PREFIX/share/doc/libunistring-1.4.2"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
