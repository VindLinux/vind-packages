src="mako-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "$PWD"
}

pkg_install()
{
    cd "$src" || exit 1
    pip3 install --break-system-packages --no-index --find-links dist --no-user --root="$DESTDIR" --prefix="$PREFIX" Mako
}
