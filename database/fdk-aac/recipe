src="fdk-aac-${PKG_VERSION}"
tarball="v${PKG_VERSION}.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    autoreconf -fi || exit 1

    set -- --prefix="$PREFIX"

    if attr_on example; then
        set -- "$@" --enable-example
    fi

    if ! attr_on static; then
        set -- "$@" --disable-static
    fi

    ./configure "$@" || exit 1
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
