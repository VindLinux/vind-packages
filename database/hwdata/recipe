src="hwdata-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
}

pkg_install()
{
    cd "$src" || exit 1

    install -dm755 "$DESTDIR$PREFIX/share/hwdata" "$DESTDIR$PREFIX/share/pkgconfig" || exit 1

    for f in pci.ids usb.ids oui.txt iab.txt pnp.ids; do
        install -m644 "$f" "$DESTDIR$PREFIX/share/hwdata/$f" || exit 1
    done

    sed -e "s|@prefix@|$PREFIX|g" \
        -e 's|@datadir@|${prefix}/share|g' \
        -e 's|@pkgdatadir@|${datadir}/hwdata|g' \
        -e "s|@VERSION@|$PKG_VERSION|g" \
        -e 's|@NAME@|hwdata|g' \
        hwdata.pc.in > "$DESTDIR$PREFIX/share/pkgconfig/hwdata.pc" || exit 1
}
