src="hwdata-$PKG_VERSION"
tarball="$src.tar.gz"

pkg_download()
{
    curl -fL --retry 3 --retry-delay 2 -o "$tarball" \
        "https://github.com/vcrhonek/hwdata/archive/refs/tags/v$PKG_VERSION.tar.gz" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$PREFIX"
}

pkg_install()
{
    cd "$src" || exit 1

    install -dm755 "$DESTDIR$PREFIX/share/hwdata" "$DESTDIR$PREFIX/share/pkgconfig" || exit 1

    for f in pci.ids usb.ids oui.txt iab.txt pnp.ids; do
        install -m644 "$f" "$DESTDIR$PREFIX/share/hwdata/$f" || exit 1
    done

    install -m644 hwdata.pc "$DESTDIR$PREFIX/share/pkgconfig/hwdata.pc" || exit 1
}
