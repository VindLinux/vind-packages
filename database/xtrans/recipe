src="xtrans-1.6.0"

pkg_download()
{
    fetch_source xtrans-1.6.0.tar.xz || exit 1
    tar -xf xtrans-1.6.0.tar.xz
}

pkg_build()
{
    cd "$src" || exit 1
    ./configure --prefix="$XORG_PREFIX" --docdir="$XORG_PREFIX/share/doc/xtrans-1.6.0"
    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
