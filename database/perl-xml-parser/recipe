src="XML-Parser-${PKG_VERSION}"
tarball="$src.tar.gz"

pkg_download()
{
    fetch_source "$tarball" || exit 1
    tar -xf "$tarball" || exit 1
}

pkg_build()
{
    cd "$src" || exit 1

    perl Makefile.PL INSTALLDIRS=site \
        EXPATLIBPATH="$PREFIX/lib" \
        EXPATINCPATH="$PREFIX/include" || exit 1

    make $MAKEOPTS
}

pkg_install()
{
    cd "$src" || exit 1
    make DESTDIR="$DESTDIR" install
}
